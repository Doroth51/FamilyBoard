{% extends 'base.html.twig' %}

{% block title %}Email envoyé{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 text-center">

                        <h2 class="mb-4">Vérifiez votre boîte mail</h2>

                        <p class="text-muted mb-4">
                            Un email contenant un lien de confirmation vous a été envoyé.
                            Cliquez sur ce lien pour continuer.
                        </p>

                        <i class="bi bi-envelope-check" style="font-size: 3rem;"></i>

                        <p class="mt-4">
                            Si vous ne recevez rien, vérifiez vos spams ou
                            <a href="{{ path('app_register') }}">réessayez</a>.
                        </p>

                    </div>
                </div>

            </div>
        </div>

    </div>
{% endblock %}
