{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">

        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="card shadow-sm p-4">

                    <h2 class="mb-4 text-center">Nouveau mot de passe</h2>

                    <form method="post">

                        <div class="position-relative mb-3">
                            <div class="form-floating">
                                <input
                                    type="password"
                                    name="password"
                                    class="form-control password-field"
                                    id="pwd"
                                    placeholder="Mot de passe"
                                    required
                                >
                                <label for="pwd">Nouveau mot de passe</label>
                            </div>

                            <span
                                class="toggle-password position-absolute top-50 end-0 translate-middle-y me-3"
                                style="cursor:pointer; font-size:1.3rem;"
                            >
                                👁️
                            </span>
                        </div>

                        <button class="btn btn-success w-100 py-2">Réinitialiser</button>

                    </form>

                </div>

            </div>
        </div>

    </div>

    <script>
        document.querySelectorAll(".toggle-password").forEach((icon) => {
            icon.addEventListener("click", () => {
                const input = icon.parentElement.querySelector(".password-field");

                if (input.type === "password") {
                    input.type = "text";
                    icon.textContent = "🙈";
                } else {
                    input.type = "password";
                    icon.textContent = "👁️";
                }
            });
        });
    </script>
{% endblock %}
