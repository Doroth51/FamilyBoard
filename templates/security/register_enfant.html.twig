{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">

        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="card shadow-sm p-4">
                    <h2 class="mb-3 text-center">Créer ton compte</h2>

                    <p class="text-muted text-center">
                        Email : {{ invitation.email }}
                    </p>

                    <form method="post">
                        <div class="form-floating mb-3">
                            <input type="password" name="password" class="form-control" id="pwd" placeholder="Mot de passe" required>
                            <label for="pwd">Mot de passe</label>
                        </div>

                        <button class="btn btn-primary w-100 py-2">Créer mon compte</button>
                    </form>

                </div>

            </div>
        </div>

    </div>
{% endblock %}
