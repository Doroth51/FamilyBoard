{% extends 'base.html.twig' %}

{% block title %}Connexion — FamilyBoard{% endblock %}

{% block body %}
    <div class="login-container">
        <h1>Connexion</h1>

        {% if error %}
            <div class="error">Identifiants incorrects</div>
        {% endif %}

        <form method="post">
            <label>Email</label>
            <input type="email" name="username" value="{{ last_username }}" required>

            <label>Mot de passe</label>
            <input type="password" name="password" required>

            <button class="btn btn-primary">Se connecter</button>
        </form>

        <p class="register-link">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}">Créer un compte</a>
        </p>
    </div>

    <style>
        .login-container {
            max-width: 400px;
            margin: 60px auto;
            padding: 30px;
            border-radius: 10px;
            background: #f9f9f9;
            text-align: center;
        }
        label {
            display: block;
            margin-top: 15px;
            text-align: left;
        }
        input {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
        }
        .error {
            background: #e74c3c;
            color: white;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 15px;
        }
        .register-link {
            margin-top: 20px;
        }
    </style>
{% endblock %}
