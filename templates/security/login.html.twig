{% extends 'base.html.twig' %}

{% block title %}Connexion — FamilyBoard{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <h2 class="mb-4 text-center">Connexion</h2>

                        {% if error %}
                            <div class="alert alert-danger">
                                Identifiants incorrects
                            </div>
                        {% endif %}

                        <form method="post">

                            <div class="form-floating mb-3">
                                <input
                                    type="email"
                                    name="username"
                                    value="{{ last_username }}"
                                    class="form-control"
                                    id="loginEmail"
                                    placeholder="Adresse email"
                                    required
                                >
                                <label for="loginEmail">Adresse email</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input
                                    type="password"
                                    name="password"
                                    class="form-control password-field"
                                    id="loginPassword"
                                    placeholder="Mot de passe"
                                    required
                                >
                                <label for="loginPassword">Mot de passe</label>
                                <span
                                    class="toggle-password position-absolute top-50 end-0 translate-middle-y me-3"
                                    style="cursor:pointer; font-size:1.3rem;"
                                >
                                    🙈
                                </span>
                            </div>

                            <button class="btn btn-primary w-100 py-2">
                                Se connecter
                            </button>

                        </form>

                        <p class="text-center mt-3">
                            Pas encore de compte ?
                            <a href="{{ path('app_register') }}">Créer un compte</a>
                        </p>

                    </div>
                </div>

            </div>
        </div>

    </div>
    <script>
        document.querySelectorAll(".toggle-password").forEach((icon) => {
            icon.addEventListener("click", () => {
                const input = icon.parentElement.querySelector(".password-field");
                if (input.type === "password") {
                    input.type = "text";
                    icon.textContent = "🐵";
                } else {
                    input.type = "password";
                    icon.textContent = "🙈";
                }
            });
        });
    </script>
{% endblock %}
