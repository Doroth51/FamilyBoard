{% extends 'base.html.twig' %}

{% block title %}Niveaux — FamilyBoard{% endblock %}

{% block body %}
    <div class="container py-5">

        <h2 class="mb-4">Liste des niveaux</h2>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for niveau in niveaux %}
                    <tr>
                        <td>{{ niveau.id }}</td>
                        <td>{{ niveau.name }}</td>
                        <td>
                            <a href="{{ path('niveau_show', {id: niveau.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                            <a href="{{ path('niveau_edit', {id: niveau.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('niveau_new') }}" class="btn btn-success">Créer un niveau</a>

    </div>
{% endblock %}
