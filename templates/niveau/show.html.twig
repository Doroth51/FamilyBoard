{% extends 'base.html.twig' %}

{% block title %}Niveau{% endblock %}

{% block body %}
    <div class="container py-5">

        <h2 class="mb-4">Niveau {{ niveau.name }}</h2>

        <ul class="list-group mb-4">
            <li class="list-group-item"><strong>Nom :</strong> {{ niveau.name }}</li>
        </ul>

        <a href="{{ path('niveau_edit', {id: niveau.id}) }}" class="btn btn-warning">Modifier</a>
        <a href="{{ path('niveau_index') }}" class="btn btn-secondary">Retour</a>

    </div>
{% endblock %}
