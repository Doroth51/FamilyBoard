{% extends 'base.html.twig' %}

{% block title %}Groupe familial : {{ family_group.name }}{% endblock %}

{% block body %}
    <div class="container py-5">

        <h2 class="mb-4">Groupe familial : {{ family_group.name }}</h2>

        <div class="card shadow-sm p-4 mb-4">
            <h4>Parents</h4>

            {% if family_group.users|length > 0 %}
                <ul>
                    {% for user in family_group.users %}
                        <li>{{ user.prenom }} {{ user.nom }} — {{ user.email }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-muted">Aucun parent associé.</p>
            {% endif %}
        </div>

        <div class="card shadow-sm p-4 mb-4">
            <h4>Enfants</h4>

            {% if family_group.enfants|length > 0 %}
                <ul>
                    {% for enfant in family_group.enfants %}
                        <li>{{ enfant.name }} — Classe : {{ enfant.classe.name }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-muted">Aucun enfant associé.</p>
            {% endif %}
        </div>

        <a href="{{ path('family_group_edit', {id: family_group.id}) }}" class="btn btn-warning">Modifier</a>
        <a href="{{ path('family_group_index') }}" class="btn btn-secondary">Retour</a>

    </div>
{% endblock %}
