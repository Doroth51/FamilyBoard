{% extends 'base.html.twig' %}

{% block title %}Modifier le groupe familial{% endblock %}

{% block body %}
    <div class="container py-5">

        <h2 class="mb-4">Modifier {{ family_group.name }}</h2>

        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-warning mt-3">Mettre à jour</button>
        {{ form_end(form) }}

        <a href="{{ path('family_group_show', {id: family_group.id}) }}" class="btn btn-secondary mt-3">Retour</a>

    </div>
{% endblock %}
