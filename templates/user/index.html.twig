{% extends 'base.html.twig' %}

{% block title %}Utilisateurs — FamilyBoard{% endblock %}

{% block body %}
    <div class="container py-5">

        <h2 class="mb-4">Liste des utilisateurs</h2>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Famille</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.nom }}</td>
                        <td>{{ user.prenom }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.familyName }}</td>
                        <td>
                            <a href="{{ path('user_show', {id: user.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                            <a href="{{ path('user_edit', {id: user.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('user_new') }}" class="btn btn-success">Créer un utilisateur</a>

    </div>
{% endblock %}
