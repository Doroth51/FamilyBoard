{% extends 'base.html.twig' %}

{% block title %}Profil utilisateur{% endblock %}

{% block body %}
    <div class="container py-5">

        <h2 class="mb-4">Profil de {{ user.prenom }} {{ user.nom }}</h2>

        <ul class="list-group mb-4">
            <li class="list-group-item"><strong>Email :</strong> {{ user.email }}</li>
            <li class="list-group-item"><strong>Nom :</strong> {{ user.nom }}</li>
            <li class="list-group-item"><strong>Prénom :</strong> {{ user.prenom }}</li>
            <li class="list-group-item"><strong>Famille :</strong> {{ user.familyName }}</li>
        </ul>

        <a href="{{ path('user_edit', {id: user.id}) }}" class="btn btn-warning">Modifier</a>
        <a href="{{ path('user_index') }}" class="btn btn-secondary">Retour</a>

    </div>
{% endblock %}
