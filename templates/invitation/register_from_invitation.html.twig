{% extends 'base.html.twig' %}

{% block title %}Créer votre compte{% endblock %}

{% block body %}
    <div class="container mt-4">

        <h1 class="mb-3">Créer votre compte FamilyBoard</h1>

        <p class="text-muted">
            Vous avez été invité avec l’adresse : <strong>{{ email }}</strong>
        </p>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="card p-4">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, { 'attr': {'class': 'form-control', 'readonly': true} }) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.password.first) }}
                {{ form_widget(form.password.first, { 'attr': {'class': 'form-control'} }) }}
                {{ form_errors(form.password.first) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.password.second) }}
                {{ form_widget(form.password.second, { 'attr': {'class': 'form-control'} }) }}
                {{ form_errors(form.password.second) }}
            </div>

            <button class="btn btn-success">Créer mon compte</button>

            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
