{% extends 'base.html.twig' %}

{% block title %}Détail de la note{% endblock %}

{% block body %}
    <h1>{{ note.matiere }}</h1>

    <p>Note : {{ note.note }}/{{ note.denominateur }}</p>
    <p>Coefficient : {{ note.coefficient }}</p>
    <p>Enfant : {{ note.enfant.name }}</p>
    <p>Période : {{ note.periode.type }} {{ note.periode.numero }}</p>

    <form method="post" action="{{ path('note_delete', {id: note.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ note.id) }}">
        <button type="submit">Supprimer</button>
    </form>

    <a href="{{ path('note_index') }}">Retour</a>
{% endblock %}
