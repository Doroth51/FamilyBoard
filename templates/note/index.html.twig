{% extends 'base.html.twig' %}

{% block title %}Notes{% endblock %}

{% block body %}
    <h1>Liste des notes</h1>

    <a href="{{ path('note_new') }}">Ajouter une note</a>

    <table>
        <thead>
            <tr>
                <th>Matière</th>
                <th>Note</th>
                <th>Coef</th>
                <th>Enfant</th>
                <th>Période</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for note in notes %}
                <tr>
                    <td>{{ note.matiere }}</td>
                    <td>{{ note.note }}/{{ note.denominateur }}</td>
                    <td>{{ note.coefficient }}</td>
                    <td>{{ note.enfant.name }}</td>
                    <td>{{ note.periode.type }} {{ note.periode.numero }}</td>
                    <td>
                        <a href="{{ path('note_show', {id: note.id}) }}">Voir</a>
                        <a href="{{ path('note_edit', {id: note.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
