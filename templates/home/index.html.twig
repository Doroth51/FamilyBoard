{% extends 'base.html.twig' %}

{% block title %}FamilyBoard — Bienvenue{% endblock %}

{% block body %}

    <div class="landing">

        <div class="hero">
            <h1>FamilyBoard</h1>
            <p class="subtitle">
                L’application familiale qui centralise les notes, appréciations, récompenses et progression scolaire de vos enfants.
            </p>

            <div class="cta">
                <a href="{{ path('app_login') }}" class="btn btn-primary">Connexion</a>
                <a href="{{ path('app_register') }}" class="btn btn-secondary">Créer un compte</a>
            </div>
        </div>

        <div class="features">
            <div class="feature">
                <h3>📚 Suivi scolaire</h3>
                <p>Notes, appréciations, progression, graphiques… tout est regroupé dans un tableau de bord clair.</p>
            </div>

            <div class="feature">
                <h3>💶 Récompenses</h3>
                <p>Suivez l’argent de poche, les bonus, et les récompenses par période.</p>
            </div>

            <div class="feature">
                <h3>👨‍👩‍👧 Gestion familiale</h3>
                <p>Chaque parent gère ses enfants, leurs périodes, leurs résultats et leurs progrès.</p>
            </div>
        </div>

    </div>

    <style>
        .landing {
            text-align: center;
            padding: 60px 20px;
        }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .subtitle {
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 30px;
        }

        .cta .btn {
            padding: 12px 20px;
            margin: 10px;
            border-radius: 8px;
            font-size: 1rem;
            text-decoration: none;
        }

        .btn-primary {
            background-color: #3498db;
            color: white;
        }

        .btn-secondary {
            background-color: #2ecc71;
            color: white;
        }

        .features {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 60px;
        }

        .feature {
            max-width: 250px;
        }
    </style>

{% endblock %}
