<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}FamilyBoard{% endblock %}</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

        <style>
            .sidebar {
                width: 260px;
                min-height: 100vh;
                background: #2c3e50;
            }

            @media (max-width: 768px) {
                .sidebar {
                    width: 100%;
                    min-height: auto;
                }
            }
        </style>
    </head>

    <body>

        <div class="d-flex flex-column flex-md-row">

            <nav class="sidebar p-3 text-white">
                <h4>FamilyBoard</h4>

                <ul class="nav flex-column mt-3">
                    <li class="nav-item"><a class="nav-link text-white" href="{{ path('dashboard_parent') }}">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="{{ path('invite_parent', { id: app.user.familyGroups|first.id }) }}">Inviter un parent</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="{{ path('invitations_list', { id: app.user.familyGroups|first.id }) }}">Invitations</a></li>
                </ul>
            </nav>

            <main class="flex-fill p-4">
                {% block body %}{% endblock %}
            </main>

        </div>

    </body>
</html>
