{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    <div class="container py-4">

        <h1 class="mb-4">Administration FamilyBoard</h1>

        <div class="row g-3">

            <div class="col-12 col-md-4">
                <a href="{{ path('user_index') }}" class="text-decoration-none">
                    <div class="card shadow-sm p-3 text-center">
                        <h5>Parents</h5>
                        <p class="display-6">{{ users|length }}</p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <a href="{{ path('family_group_index') }}" class="text-decoration-none">
                    <div class="card shadow-sm p-3 text-center">
                        <h5>Groupes familiaux</h5>
                        <p class="display-6">{{ groups|length }}</p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <a href="{{ path('enfant_index') }}" class="text-decoration-none">
                    <div class="card shadow-sm p-3 text-center">
                        <h5>Enfants</h5>
                        <p class="display-6">{{ enfants|length }}</p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <a href="{{ path('niveau_index') }}" class="text-decoration-none">
                    <div class="card shadow-sm p-3 text-center">
                        <h5>Niveaux</h5>
                        <p class="display-6">{{ niveaux|length }}</p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <a href="{{ path('classe_index') }}" class="text-decoration-none">
                    <div class="card shadow-sm p-3 text-center">
                        <h5>Classes</h5>
                        <p class="display-6">{{ classes|length }}</p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <a href="{{ path('admin_invitations') }}" class="text-decoration-none">
                    <div class="card shadow-sm p-3 text-center">
                        <h5>Invitations</h5>
                        <p class="display-6">{{ invitations|length }}</p>
                    </div>
                </a>
            </div>

        </div>

    </div>
{% endblock %}
