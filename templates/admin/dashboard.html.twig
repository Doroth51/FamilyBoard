{% extends 'base.html.twig' %}

{% block title %}Administration FamilyBoard{% endblock %}

{% block body %}
    <div class="admin-layout">

        <aside class="sidebar">
            <h2>Administration</h2>
            <ul>
                <li><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                <li><a href="{{ path('user_index') }}">Parents</a></li>
                <li><a href="{{ path('familygroup_index') }}">Groupes familiaux</a></li>
                <li><a href="{{ path('enfant_index') }}">Enfants</a></li>
                <li><a href="{{ path('matiere_index') }}">Matières</a></li>
                <li><a href="{{ path('periode_index') }}">Périodes</a></li>
                <li><a href="{{ path('note_index') }}">Notes</a></li>
                <li><a href="{{ path('evaluation_index') }}">Évaluations</a></li>
                <li><a href="{{ path('admin_invitations') }}">Invitations</a></li>
            </ul>
        </aside>

        <main class="content">
            <h1>Dashboard Administrateur</h1>

            <div class="cards">

                <a href="{{ path('user_index') }}" class="card">
                    <h3>Parents</h3>
                    <p>{{ users|length }} comptes</p>
                </a>

                <a href="{{ path('familygroup_index') }}" class="card">
                    <h3>Groupes familiaux</h3>
                    <p>{{ groups|length }} groupes</p>
                </a>

                <a href="{{ path('enfant_index') }}" class="card">
                    <h3>Enfants</h3>
                    <p>{{ enfants|length }} enfants</p>
                </a>

                <a href="{{ path('admin_invitations') }}" class="card">
                    <h3>Invitations</h3>
                    <p>{{ invitations|length }} invitations envoyées</p>
                </a>

            </div>
        </main>

    </div>

    <style>
        .admin-layout {
            display: flex;
            min-height: 90vh;
        }
        .sidebar {
            width: 240px;
            background: #2c3e50;
            padding: 20px;
            color: white;
        }
        .sidebar h2 {
            margin-bottom: 20px;
        }
        .sidebar ul {
            list-style: none;
            padding: 0;
        }
        .sidebar li {
            margin: 12px 0;
        }
        .sidebar a {
            color: white;
            text-decoration: none;
        }
        .content {
            flex: 1;
            padding: 30px;
        }
        .cards {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }
        .card {
            background: #ecf0f1;
            padding: 20px;
            border-radius: 8px;
            width: 220px;
            text-align: center;
            text-decoration: none;
            color: #2c3e50;
            font-weight: bold;
            transition: 0.2s;
        }
        .card:hover {
            background: #bdc3c7;
        }
    </style>

{% endblock %}
