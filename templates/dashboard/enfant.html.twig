{% extends 'base.html.twig' %}

{% block title %}Dashboard — {{ enfant.name }}{% endblock %}

{% block body %}
    <div class="container py-4">

        <div style="display:flex; justify-content:space-between">
            <!-- HEADER -->
            <div class="d-flex align-items-center gap-3 mb-4">
                {# <img src="/images/avatar-default.png" class="rounded-circle" width="80"> #}
                <div>
                    <h2 class="mb-1">{{ enfant.name }}</h2>
                    <p class="text-muted mb-0">{{ enfant.classe.name }}</p>
                    {# <p class="text-muted mb-0">Période : {{ periode.type }} {{ periode.numero }}</p> #}
                </div>
            </div>

            {% if enfant.evaluationMode === 'note' %}
                <div id="boxMultibarNote" style="width: -webkit-fill-available; padding: 0em 5em 0em 5em;"></div>
            {% else %}
                <div id="boxMultibarCompetence" style="width: -webkit-fill-available; padding: 0em 5em 0em 5em;"></div>
            {% endif %}

        </div>
        

        {% if enfant.evaluationMode === 'note' %}
            <!-- NOTES -->
            <!-- afficher la moyenne -->
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Matière</th>
                        <th>Moyenne</th>
                    </tr>
                </thead>
                <tbody>
                    {% if matieres is not empty %}
                        {% for matiere in matieres %}
                            <tr
                                class="matiere-row"
                                data-target="notes-{{ matiere.id }}"
                                style="cursor:pointer;"
                            >
                                <td>
                                    <i class="fas fa-chevron-right me-2"></i>
                                    {{ matiere.nom }}
                                </td>
                                <td>{{ matiere.moyenne|number_format(2, ',', ' ') }}</td>
                            </tr>
                            <tr id="notes-{{ matiere.id }}" class="notes-detail" style="display:none;">
                                <td colspan="2">
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Libelle</th>
                                                <th>Note</th>
                                                <th>Coefficient</th>
                                                <th>Rémunération</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for note in matiere.notes %}
                                                <tr>
                                                    <td>{{ note.date|date('d/m/Y') }}</td>
                                                    <td>{{ note.libelle }}</td>
                                                    <td>{{ note.note }} / {{ note.denominateur }}</td>
                                                    <td>{{ note.coefficient|default(1) }}</td>
                                                    <td>
                                                        {% if note.isRemuneration() %}
                                                            {% if note.remuneration is not empty %}
                                                                {{ note.remuneration.montant }}
                                                            {% else %}
                                                                A venir  
                                                            {% endif %}
                                                        {% else %}
                                                            Aucune rémunération prévue
                                                        {% endif %}
                                                        
                                                    </td>
                                                    <td>
                                                        <a
                                                            href="{{ path('note_show', {id: note.id}) }}"
                                                            type="button"
                                                            class="btn btn-success btn-sm"
                                                        >Voir</a>
                                                        <a
                                                            {# href="{{ path('note_edit', {noteId: note.id, enfantId: enfant.id}) }}" #}
                                                            type="button"
                                                            class="btn btn-sm btn-warning"
                                                        >Modifier</a>
                                                        <button
                                                            type="button"
                                                            class="btn btn-danger btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteModal{{ note.id }}"
                                                        >
                                                            Supprimer
                                                        </button>
                                                        <a
                                                            href="{{ path('new_remuneration_note_by_enfant', {enfantId: enfant.id, noteId: note.id}) }}"
                                                            type="button"
                                                            class="btn btn-info btn-sm"
                                                        >Rémunérer</a>
                                                    </td>
                                                </tr>
                                                <div
                                                    class="modal fade"
                                                    id="deleteModal{{ note.id }}"
                                                    tabindex="-1"
                                                    aria-labelledby="deleteModalLabel{{ note.id }}"
                                                    aria-hidden="true"
                                                >

                                                    <div class="modal-dialog">
                                                        <div class="modal-content">

                                                            <div class="modal-header">
                                                                <h5
                                                                    class="modal-title"
                                                                    id="deleteModalLabel{{ note.id }}"
                                                                >
                                                                    Confirmation
                                                                </h5>

                                                                <button
                                                                    type="button"
                                                                    class="btn-close"
                                                                    data-bs-dismiss="modal"
                                                                    aria-label="Close"
                                                                >
                                                                </button>
                                                            </div>

                                                            <div class="modal-body">
                                                                Êtes-vous sûr de vouloir supprimer la note ?
                                                            </div>

                                                            <div class="modal-footer">
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-secondary"
                                                                    data-bs-dismiss="modal"
                                                                >
                                                                    Annuler
                                                                </button>
                                                                <form
                                                                    method="post"
                                                                    ,
                                                                    action="{{ path('note_delete', {id: note.id}) }}"
                                                                >
                                                                    <input
                                                                        type="hidden"
                                                                        name="_token"
                                                                        value="{{ csrf_token('delete' ~ note.id) }}"
                                                                    >

                                                                    <button
                                                                        type="submit"
                                                                        class="btn btn-danger"
                                                                    >
                                                                        Supprimer
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% else %}
                                                <tr>
                                                    <td colspan="3">Aucune note</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        
            <!-- bouton ajouter note -->
            <a href="{{ path('note_new', {enfantId: enfant.id}) }}" class="btn btn-success">Ajouter une note</a>

        {% else %}
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Matière</th>
                        <th>Nombre d'évaluations</th>
                    </tr>
                </thead>
                <tbody>
                    {% for nomMatiere, evaluations in evaluationsParMatiere %}
                        <tr
                            class="matiere-row"
                            data-target="matiere-{{ loop.index }}"
                            style="cursor:pointer;"
                        >
                            <td><i class="fas fa-chevron-right me-2"></i>{{ nomMatiere }}</td>
                            <td>{{ evaluations|length }}</td>
                        </tr>
                        
                        
                        <tr id="matiere-{{ loop.index }}" style="display:none">
                            <td colspan="2">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Libelle</th>
                                            <th>Appréciation</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for evaluation in evaluations %}
                                            <tr>
                                                <td>{{ evaluation.date|date('d/m/Y') }}</td>
                                                <td>{{ evaluation.libelle }}</td>
                                                <td>{{ evaluation.niveau }}</td>
                                                <td>
                                                    <a
                                                        href="{{ path('evaluation_show', {id: evaluation.id}) }}"
                                                        type="button"
                                                        class="btn btn-success btn-sm"
                                                    >Voir</a>
                                                    <a
                                                        {# href="{{ path('evaluation_edit', {id: evaluation.id}) }}" #}
                                                        type="button"
                                                        class="btn btn-warning btn-sm"
                                                    >Modifier</a>
                                                    <button
                                                        type="button"
                                                        class="btn btn-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal{{ evaluation.id }}"
                                                    >
                                                        Supprimer
                                                    </button>
                                                    <a
                                                        href="{{ path('new_remuneration_evaluation_by_enfant', {enfantId: enfant.id, evaluationId: evaluation.id}) }}"
                                                        type="button"
                                                        class="btn btn-info btn-sm"
                                                    >Rémunérer</a>
                                                </td>
                                            </tr>
                                            <div
                                                class="modal fade"
                                                id="deleteModal{{ evaluation.id }}"
                                                tabindex="-1"
                                                aria-labelledby="deleteModalLabel{{ evaluation.id }}"
                                                aria-hidden="true"
                                            >

                                                <div class="modal-dialog">
                                                    <div class="modal-content">

                                                        <div class="modal-header">
                                                            <h5
                                                                class="modal-title"
                                                                id="deleteModalLabel{{ evaluation.id }}"
                                                            >
                                                                Confirmation
                                                            </h5>

                                                            <button
                                                                type="button"
                                                                class="btn-close"
                                                                data-bs-dismiss="modal"
                                                                aria-label="Close"
                                                            >
                                                            </button>
                                                        </div>

                                                        <div class="modal-body">
                                                            Êtes-vous sûr de vouloir supprimer l'évaluation ?
                                                        </div>

                                                        <div class="modal-footer">
                                                            <button
                                                                type="button"
                                                                class="btn btn-secondary"
                                                                data-bs-dismiss="modal"
                                                            >
                                                                Annuler
                                                            </button>
                                                            <form
                                                                method="post"
                                                                ,
                                                                action="{{ path('evaluation_delete', {id: evaluation.id}) }}"
                                                            >
                                                                <input
                                                                    type="hidden"
                                                                    name="_token"
                                                                    value="{{ csrf_token('delete' ~ evaluation.id) }}"
                                                                >

                                                                <button
                                                                    type="submit"
                                                                    class="btn btn-danger"
                                                                >
                                                                    Supprimer
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        {% else %}
                                            <tr>
                                                <td colspan="3">Aucune évaluation</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        
                       
                    {% endfor %}
                </tbody>
            </table>
        
            <!-- bouton ajouter note -->
            <a href="{{ path('evaluation_new', {enfantId: enfant.id}) }}" class="btn btn-success">Ajouter une évaluation</a>

        {% endif %}

        {# <!-- PROGRESSION -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Progression scolaire</h4>
            <canvas id="progressChart"></canvas>
        </div>

        <!-- NOTES RÉCENTES -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Dernières notes</h4>

            {% for note in notes %}
                <div class="border rounded p-3 mb-2">
                    <strong>{{ note.matiere.name }}</strong> — {{ note.note }}/{{ note.denominateur }}
                    <p class="text-muted mb-0">{{ note.appreciation }}</p>
                </div>
            {% else %}
                <p class="text-muted">Aucune note pour le moment.</p>
            {% endfor %}
        </div>

        <!-- RÉCOMPENSES -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Récompenses</h4>

            <canvas id="rewardChart"></canvas>

            <ul class="list-group mt-3">
                {% for r in remunerations %}
                    <li class="list-group-item d-flex justify-content-between">
                        <span>{{ r.type.name }} — {{ r.date|date('d/m/Y') }}</span>
                        <strong>{{ r.montant }} €</strong>
                    </li>
                {% else %}
                    <li class="list-group-item text-muted">Aucune récompense pour le moment.</li>
                {% endfor %}
            </ul>
        </div>

        <!-- OBJECTIFS -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Objectifs</h4>

            {% for objectif in objectifs %}
                <div class="mb-3">
                    <strong>{{ objectif.titre }}</strong>
                    <div class="progress mt-2">
                        <div
                            class="progress-bar"
                            role="progressbar"
                            style="width: {{ objectif.progression }}%"
                        >
                            {{ objectif.progression }}%
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-muted">Aucun objectif défini.</p>
            {% endfor %}
        </div>

        <!-- Section XP + Niveau -->
        <div class="card shadow-sm p-3 mb-4 text-center">
            <h4 class="mb-2">Progression du niveau</h4>

            <p class="mb-1">Niveau : <strong>{{ enfant.niveau }}</strong></p>
            <p class="text-muted">XP : {{ enfant.xp }}/{{ enfant.xpRequiredForNextLevel() }}</p>

            <div class="progress mt-2">
                <div
                    class="progress-bar bg-success"
                    style="width: {{ (enfant.xp / enfant.xpRequiredForNextLevel()) * 100 }}%"
                >
                </div>
            </div>
        </div>

        <!-- Section Badges -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Badges obtenus</h4>

            <div class="d-flex flex-wrap gap-3">
                {% for badge in enfant.badges %}
                    <div class="border rounded p-3 text-center" style="width: 120px;">
                        <div class="fs-1">{{ badge.icone }}</div>
                        <strong>{{ badge.nom }}</strong>
                        <p class="text-muted small">{{ badge.dateObtention|date('d/m/Y') }}</p>
                    </div>
                {% else %}
                    <p class="text-muted">Aucun badge pour le moment.</p>
                {% endfor %}
            </div>
        </div> #}


    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.querySelectorAll(".matiere-row").forEach((row) => {
            row.addEventListener("click", () => {
                const detail = document.getElementById(row.dataset.target);
                detail.style.display =
                    detail.style.display === "table-row" ? "none" : "table-row";
            });
        });
    </script>

    <script src="{{ asset('js/multibar.js') }}" type="text/javascript" charset="utf-8"></script>
    <script>
        var bar = $("#boxMultibarNote").multibar({
            initValue: [{{ moyenne }}],
            posMarker: "outside",
            iconMarker:"arrow-down",
            min: 0,
            max: 20,
            multiBarValue: [
                {
                    visibility: "visible",
                    val: 7,
                    bgColor: "red",
                },
                {
                    visibility: "visible",
                    val: 10,
                    bgColor: "orange",
                },
                {
                    visibility: "visible",
                    val: 13,
                    bgColor: "yellow",
                },
                {
                    visibility: "visible",
                    val: 16,
                    bgColor: "green",
                },
                {
                    visibility: "visible",
                    val: 20,
                    bgColor: "blue",
                },
            ],
            type: "normal",
            thermometer: false,
            reverse: false,
            multiBarValueVisibility: "visible",
            shadow: false,
        });

        var bar = $("#boxMultibarCompetence").multibar({
            initValue: [{{ moyenne }}],
            posMarker: "outside",
            iconMarker:"arrow-down",
            min: 0,
            max: 4,
            multiBarValue: [
                {
                    visibility: "visible",
                    val: 1,
                    bgColor: "red",
                },
                {
                    visibility: "visible",
                    val: 2,
                    bgColor: "orange",
                },
                {
                    visibility: "visible",
                    val: 3,
                    bgColor: "green",
                },
                {
                    visibility: "visible",
                    val: 4,
                    bgColor: "blue",
                }
            ],
            type: "normal",
            thermometer: false,
            reverse: false,
            multiBarValueVisibility: "visible",
            shadow: false,
        });
    </script>
    
    {# <script>
    new Chart(document.getElementById('progressChart'), {
        type: 'line',
        data: {
            labels: {{ labels|json_encode|raw }},
            datasets: [{
                label: 'Progression',
                data: {{ progression|json_encode|raw }},
                borderColor: '#0d6efd',
                tension: 0.3
            }]
        }
    });

    new Chart(document.getElementById('rewardChart'), {
        type: 'bar',
        data: {
            labels: {{ rewardLabels|json_encode|raw }},
            datasets: [{
                label: 'Récompenses (€)',
                data: {{ rewardValues|json_encode|raw }},
                backgroundColor: '#198754'
            }]
        }
    });

    
</script> #}
{% endblock %}
