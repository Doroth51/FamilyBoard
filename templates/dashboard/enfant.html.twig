{% extends 'base.html.twig' %}

{% block title %}Dashboard — {{ enfant.name }}{% endblock %}

{% block body %}
    <div class="container py-4">

        <div style="display:flex; justify-content:space-between">
            <!-- HEADER -->
            <div class="d-flex align-items-center gap-3 mb-4">
                {# <img src="/images/avatar-default.png" class="rounded-circle" width="80"> #}
                <div>
                    <h2 class="mb-1">{{ enfant.name }}</h2>
                    <p class="text-muted mb-0">{{ enfant.classe.name }}</p>
                    {# <p class="text-muted mb-0">Période : {{ periode.type }} {{ periode.numero }}</p> #}
                </div>
            </div>

            {% if enfant.evaluationMode === 'note' %}
                <div id="boxMultibarNote" style="width: -webkit-fill-available; padding: 0em 5em 0em 5em;"></div>
            {% else %}
                <div id="boxMultibarCompetence" style="width: -webkit-fill-available; padding: 0em 5em 0em 5em;"></div>
            {% endif %}

        </div>
        {% if enfant.evaluationMode === 'note' %}
            <table class="table notes-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Libellé</th>
                        <th>Note</th>
                        <th>Coefficient</th>
                        <th>Rémunération</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for matiere in matieres %}

                        {# Ligne matière + moyenne #}
                        <tr
                            class="table-secondary matiere-row"
                            data-target="notes-matiere-{{ matiere.id }}"
                            style="cursor:pointer;"
                        >
                            <td colspan="6">
                                <i class="fas fa-chevron-right me-2"></i>
                                <strong>{{ matiere.nom }}</strong>

                                <span class="float-end">
                                    Moyenne : {{ matiere.moyenne|number_format(2, ',', ' ') }}
                                </span>
                            </td>
                        </tr>

                        {# Notes de la matière #}
                        {% for note in matiere.notes %}
                            <tr
                                id="matiere-{{ matiere.id }}"
                                class="notes-detail notes-matiere-{{ matiere.id }}"
                                style="display:none;"
                            >
                                <td>{{ note.date|date('d/m/Y') }}</td>
                                <td>{{ note.libelle }}</td>
                                <td style="text-align: center;">{{ note.note }} / {{ note.denominateur }}</td>
                                <td style="text-align: center;">{{ note.coefficient|default(1) }}</td>
                                <td style="text-align: center;">
                                    {% if note.isRemuneration() %}
                                        {% if note.remuneration is not empty %}
                                            {{ note.remuneration.montant }}
                                        {% else %}
                                            À venir
                                        {% endif %}
                                    {% else %}
                                        Aucune rémunération prévue
                                    {% endif %}
                                </td>
                                <td>
                                    <a
                                        href="{{ path('note_show', {id: note.id}) }}"
                                        type="button"
                                        class="btn btn-success btn-sm"
                                    >Voir</a>

                                    <a
                                        {# href="{{ path('note_edit', {noteId: note.id, enfantId: enfant.id}) }}" #}
                                        type="button"
                                        class="btn btn-sm btn-warning"
                                    >Modifier</a>

                                    <button
                                        type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal{{ note.id }}"
                                    >
                                        Supprimer
                                    </button>

                                    <a
                                        href="{{ path('new_remuneration_note_by_enfant', {enfantId: enfant.id, noteId: note.id}) }}"
                                        type="button"
                                        class="btn btn-info btn-sm"
                                    >Rémunérer</a>
                                </td>
                            </tr>

                            {# Modal suppression #}
                            <div
                                class="modal fade"
                                id="deleteModal{{ note.id }}"
                                tabindex="-1"
                                aria-labelledby="deleteModalLabel{{ note.id }}"
                                aria-hidden="true"
                            >
                                <div class="modal-dialog">
                                    <div class="modal-content">

                                        <div class="modal-header">
                                            <h5
                                                class="modal-title"
                                                id="deleteModalLabel{{ note.id }}"
                                            >
                                                Confirmation
                                            </h5>

                                            <button
                                                type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                            ></button>
                                        </div>

                                        <div class="modal-body">
                                            Êtes-vous sûr de vouloir supprimer la note ?
                                        </div>

                                        <div class="modal-footer">
                                            <button
                                                type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal"
                                            >
                                                Annuler
                                            </button>
                                            <form
                                                method="post"
                                                ,
                                                action="{{ path('note_delete', {id: note.id}) }}"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('delete' ~ note.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="btn btn-danger"
                                                >
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        {% else %}
                            <tr
                                id="matiere-{{ matiere.id }}"
                                class="notes-detail"
                                style="display:none;"
                            >
                                <td colspan="6">Aucune note</td>
                            </tr>
                        {% endfor %}

                    {% endfor %}
                </tbody>
            </table>     

            <!-- bouton ajouter note -->
            <a href="{{ path('note_new', {enfantId: enfant.id}) }}" class="btn btn-success">Ajouter une note</a>  

        {% else %}
            <table class="table evaluations-table">
                <thead>
                    <tr>
                        <th class="col-eval-date">Date</th>
                        <th class="col-eval-libelle">Libellé</th>
                        <th class="col-eval-appreciation">Appréciation</th>
                        <th class="col-eval-rem">Rémunération</th>
                        <th class="col-eval-actions">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for nomMatiere, data in evaluationsParMatiere %}
                        {# Ligne matière #}
                        <tr
                            class="table-secondary matiere-row"
                            data-target="evaluations-matiere-{{ loop.index }}"
                            style="cursor:pointer;"
                        >
                            <td colspan="5">
                                <i class="fas fa-chevron-right me-2"></i>
                                <strong>{{ nomMatiere }}</strong>

                                <span class="float-end">
                                    {{ data.evaluations|length }}
                                    évaluation(s)
                                    ,
                                    score moyen :
                                    {{ data.scoreMoyen|number_format(2, ',', ' ') }}
                                </span>
                            </td>
                        </tr>

                        {% for evaluation in data.evaluations %}
                            <tr
                                class="notes-detail evaluations-matiere-{{ loop.parent.loop.index }}"
                                style="display:none;"
                            >
                                <td>{{ evaluation.date|date('d/m/Y') }}</td>
                                <td>{{ evaluation.libelle }}</td>
                                <td style="text-align:center;">{{ evaluation.niveau }}</td>
                                <td>
                                    {% if evaluation.isRemuneration() %}
                                        {% if evaluation.remuneration is not empty %}
                                            {{ evaluation.remuneration.montant }}
                                        {% else %}
                                            À venir
                                        {% endif %}
                                    {% else %}
                                        Aucune rémunération prévue
                                    {% endif %}
                                </td>
                                <td>
                                    <a
                                        href="{{ path('evaluation_show', {id: evaluation.id}) }}"
                                        type="button"
                                        class="btn btn-success btn-sm"
                                    >Voir</a>
                                    <a
                                        {# href="{{ path('evaluation_edit', {id: evaluation.id}) }}" #}
                                        type="button"
                                        class="btn btn-warning btn-sm"
                                    >Modifier</a>
                                    <button
                                        type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal{{ evaluation.id }}"
                                    >
                                        Supprimer
                                    </button>
                                    <a
                                        href="{{ path('new_remuneration_evaluation_by_enfant', {enfantId: enfant.id, evaluationId: evaluation.id}) }}"
                                        type="button"
                                        class="btn btn-info btn-sm"
                                    >Rémunérer</a>
                                </td>
                            </tr>

                            {# Modal suppression #}
                            <div
                                class="modal fade"
                                id="deleteModal{{ evaluation.id }}"
                                tabindex="-1"
                                aria-labelledby="deleteModalLabel{{ evaluation.id }}"
                                aria-hidden="true"
                            >
                                <div class="modal-dialog">
                                    <div class="modal-content">

                                        <div class="modal-header">
                                            <h5
                                                class="modal-title"
                                                id="deleteModalLabel{{ evaluation.id }}"
                                            >
                                                Confirmation
                                            </h5>

                                            <button
                                                type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                            ></button>
                                        </div>

                                        <div class="modal-body">
                                            Êtes-vous sûr de vouloir supprimer l'évaluation ?
                                        </div>

                                        <div class="modal-footer">
                                            <button
                                                type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal"
                                            >
                                                Annuler
                                            </button>

                                            }}"
                                            >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete' ~ evaluation.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-danger"
                                            >
                                                Supprimer
                                            </button>
                                            </form>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        {% else %}
                            <tr
                                class="notes-detail evaluations-matiere-{{ loop.index }}"
                                style="display:none;"
                            >
                                <td colspan="4">
                                    Aucune évaluation
                                </td>
                            </tr>
                        {% endfor %}

                    {% endfor %}
                </tbody>
            </table>

            <!-- bouton ajouter note -->
            <a href="{{ path('evaluation_new', {enfantId: enfant.id}) }}" class="btn btn-success">Ajouter une évaluation</a>
        {% endif %}

        {# <!-- PROGRESSION -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Progression scolaire</h4>
            <canvas id="progressChart"></canvas>
        </div>

        <!-- NOTES RÉCENTES -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Dernières notes</h4>

            {% for note in notes %}
                <div class="border rounded p-3 mb-2">
                    <strong>{{ note.matiere.name }}</strong> — {{ note.note }}/{{ note.denominateur }}
                    <p class="text-muted mb-0">{{ note.appreciation }}</p>
                </div>
            {% else %}
                <p class="text-muted">Aucune note pour le moment.</p>
            {% endfor %}
        </div>

        <!-- RÉCOMPENSES -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Récompenses</h4>

            <canvas id="rewardChart"></canvas>

            <ul class="list-group mt-3">
                {% for r in remunerations %}
                    <li class="list-group-item d-flex justify-content-between">
                        <span>{{ r.type.name }} — {{ r.date|date('d/m/Y') }}</span>
                        <strong>{{ r.montant }} €</strong>
                    </li>
                {% else %}
                    <li class="list-group-item text-muted">Aucune récompense pour le moment.</li>
                {% endfor %}
            </ul>
        </div>

        <!-- OBJECTIFS -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Objectifs</h4>

            {% for objectif in objectifs %}
                <div class="mb-3">
                    <strong>{{ objectif.titre }}</strong>
                    <div class="progress mt-2">
                        <div
                            class="progress-bar"
                            role="progressbar"
                            style="width: {{ objectif.progression }}%"
                        >
                            {{ objectif.progression }}%
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-muted">Aucun objectif défini.</p>
            {% endfor %}
        </div>

        <!-- Section XP + Niveau -->
        <div class="card shadow-sm p-3 mb-4 text-center">
            <h4 class="mb-2">Progression du niveau</h4>

            <p class="mb-1">Niveau : <strong>{{ enfant.niveau }}</strong></p>
            <p class="text-muted">XP : {{ enfant.xp }}/{{ enfant.xpRequiredForNextLevel() }}</p>

            <div class="progress mt-2">
                <div
                    class="progress-bar bg-success"
                    style="width: {{ (enfant.xp / enfant.xpRequiredForNextLevel()) * 100 }}%"
                >
                </div>
            </div>
        </div>

        <!-- Section Badges -->
        <div class="card shadow-sm p-3 mb-4">
            <h4 class="mb-3">Badges obtenus</h4>

            <div class="d-flex flex-wrap gap-3">
                {% for badge in enfant.badges %}
                    <div class="border rounded p-3 text-center" style="width: 120px;">
                        <div class="fs-1">{{ badge.icone }}</div>
                        <strong>{{ badge.nom }}</strong>
                        <p class="text-muted small">{{ badge.dateObtention|date('d/m/Y') }}</p>
                    </div>
                {% else %}
                    <p class="text-muted">Aucun badge pour le moment.</p>
                {% endfor %}
            </div>
        </div> #}


    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{ asset('js/multibar.js') }}" type="text/javascript" charset="utf-8"></script>
    <script>
        $(".matiere-row").on("click", function () {
            const target = $(this).data("target");
            $("." + target).toggle();
        });

        var bar = $("#boxMultibarNote").multibar({
            initValue: [{{ moyenne }}],
            posMarker: "outside",
            iconMarker:"arrow-down",
            min: 0,
            max: 20,
            multiBarValue: [
                {
                    visibility: "visible",
                    val: 7,
                    bgColor: "red",
                },
                {
                    visibility: "visible",
                    val: 10,
                    bgColor: "orange",
                },
                {
                    visibility: "visible",
                    val: 13,
                    bgColor: "yellow",
                },
                {
                    visibility: "visible",
                    val: 16,
                    bgColor: "green",
                },
                {
                    visibility: "visible",
                    val: 20,
                    bgColor: "blue",
                },
            ],
            type: "normal",
            thermometer: false,
            reverse: false,
            multiBarValueVisibility: "visible",
            shadow: false,
        });

        var bar = $("#boxMultibarCompetence").multibar({
            initValue: [{{ moyenne }}],
            posMarker: "outside",
            iconMarker:"arrow-down",
            min: 0,
            max: 4,
            multiBarValue: [
                {
                    visibility: "visible",
                    val: 1,
                    bgColor: "red",
                },
                {
                    visibility: "visible",
                    val: 2,
                    bgColor: "orange",
                },
                {
                    visibility: "visible",
                    val: 3,
                    bgColor: "green",
                },
                {
                    visibility: "visible",
                    val: 4,
                    bgColor: "blue",
                }
            ],
            type: "normal",
            thermometer: false,
            reverse: false,
            multiBarValueVisibility: "visible",
            shadow: false,
        });
    </script>
    
    {# <script>
    new Chart(document.getElementById('progressChart'), {
        type: 'line',
        data: {
            labels: {{ labels|json_encode|raw }},
            datasets: [{
                label: 'Progression',
                data: {{ progression|json_encode|raw }},
                borderColor: '#0d6efd',
                tension: 0.3
            }]
        }
    });

    new Chart(document.getElementById('rewardChart'), {
        type: 'bar',
        data: {
            labels: {{ rewardLabels|json_encode|raw }},
            datasets: [{
                label: 'Récompenses (€)',
                data: {{ rewardValues|json_encode|raw }},
                backgroundColor: '#198754'
            }]
        }
    });

    
</script> #}
{% endblock %}
