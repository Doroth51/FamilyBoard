{% extends 'base.html.twig' %}

{% block title %}Dashboard — {{ enfant.name }}{% endblock %}

{% block body %}
    <div class="container py-4">

        <div style="display:flex; justify-content:space-between">
            <!-- HEADER -->
            <div class="d-flex align-items-center gap-3 mb-4">

                <div
                    class="position-relative d-inline-block"
                    data-bs-toggle="modal"
                    data-bs-target="#avatarModal"
                    style="cursor:pointer;"
                >
                    <img
                        src="{{ asset('images/avatars/' ~ enfant.avatar) }}"
                        alt="Avatar"
                        class="rounded-circle"
                        width="130"
                    >

                    <span class="avatar-edit-icon">
                        <i class="bi bi-camera-fill"></i>
                    </span>
                </div>
    
                <div class="modal fade" id="avatarModal" tabindex="-1" aria-labelledby="avatarModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title" id="avatarModalLabel">
                                    Choisir un avatar
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                <div class="row g-3">

                                    {% for avatar in avatars %}
                                        <div class="col-4 col-md-3 text-center">
                                            <form
                                                method="post"
                                                action="{{ path('enfant_change_avatar', {'id': enfant.id}) }}"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="avatar"
                                                    value="{{ avatar }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="btn p-0 border-0 bg-transparent"
                                                >

                                                    <img
                                                        src="{{ asset('images/avatars/' ~ avatar) }}"
                                                        alt="{{ avatar }}"
                                                        class="rounded-circle border avatar-choice"
                                                        width="100"
                                                        height="100"
                                                    >

                                                </button>
                                            </form>
                                        </div>
                                    {% endfor %}

                                </div>
                            </div>

                        </div>
                    </div>
                </div>



                <div>
                    <h1 class="mb-1">{{ enfant.name }}</h1>
                    <p class="text-muted mb-0">{{ enfant.classe.name }}</p>
                    {# <p class="text-muted mb-0">Période : {{ periode.type }} {{ periode.numero }}</p> #}
                </div>
            </div>

            {% if enfant.evaluationMode === 'note' %}
                <div id="boxMultibarNote" style="width: -webkit-fill-available; padding: 2em 5em 0em 5em;"></div>
            {% else %}
                <div id="boxMultibarCompetence" style="width: -webkit-fill-available; padding: 2em 5em 0em 5em;"></div>
            {% endif %}

        </div>

        <div class="section">
            <div class="d-flex align-items-center gap-3 mb-4">
                <h2>Résultats</h2>
                {% if enfant.evaluationMode === 'note' %}
                    <a href="{{ path('note_new', {enfantId: enfant.id}) }}" class="btn btn-success">Ajouter une note</a> 
                {% else %}
                    <a href="{{ path('evaluation_new', {enfantId: enfant.id}) }}" class="btn btn-success">Ajouter une évaluation</a>
                {% endif %}
            </div>
            
            {% if enfant.evaluationMode === 'note' %}
                <table class="table notes-table">
                    <tbody>
                        {% for matiere in matieres %}
        
                            {# Ligne matière + moyenne #}
                            <tr
                                class="table-secondary matiere-row"
                                data-target="notes-matiere-{{ matiere.id }}"
                                style="cursor:pointer;"
                            >
                                <td colspan="6">
                                    <i class="fas fa-chevron-right me-2"></i>
                                    <strong>{{ matiere.nom }}</strong>

                                    <span class="float-end">
                                        Moyenne : {{ matiere.moyenne|number_format(2, ',', ' ') }}
                                    </span>
                                </td>
                            </tr>

                            {# Notes de la matière #}
                            {% for note in matiere.notes %}
                                <tr
                                    id="matiere-{{ matiere.id }}"
                                    class="notes-detail notes-matiere-{{ matiere.id }}"
                                    style="display:none;"
                                >
                                    <td>{{ note.date|date('d/m/Y') }}</td>
                                    <td>{{ note.libelle }}</td>
                                    <td style="text-align: center;">{{ note.note }} / {{ note.denominateur }}</td>
                                    <td style="text-align: center;">{{ note.coefficient|default(1) }}</td>
                                    <td style="text-align: center;">
                                        {% if note.isRemuneration() %}
                                            {% if note.remuneration is not empty %}
                                                {{ note.remuneration.montant }}
                                            {% else %}
                                                À venir
                                            {% endif %}
                                        {% else %}
                                            Aucune rémunération prévue
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a
                                            href="{{ path('note_show', {id: note.id}) }}"
                                            type="button"
                                            class="btn btn-success btn-sm"
                                        >Voir</a>

                                        <a
                                            {# href="{{ path('note_edit', {noteId: note.id, enfantId: enfant.id}) }}" #}
                                            type="button"
                                            class="btn btn-sm btn-warning"
                                        >Modifier</a>

                                        <button
                                            type="button"
                                            class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal{{ note.id }}"
                                        >
                                            Supprimer
                                        </button>

                                        <a
                                            href="{{ path('new_remuneration_note_by_enfant', {enfantId: enfant.id, noteId: note.id}) }}"
                                            type="button"
                                            class="btn btn-info btn-sm"
                                        >Rémunérer</a>
                                    </td>
                                </tr>

                                {# Modal suppression #}
                                <div
                                    class="modal fade"
                                    id="deleteModal{{ note.id }}"
                                    tabindex="-1"
                                    aria-labelledby="deleteModalLabel{{ note.id }}"
                                    aria-hidden="true"
                                >
                                    <div class="modal-dialog">
                                        <div class="modal-content">

                                            <div class="modal-header">
                                                <h5
                                                    class="modal-title"
                                                    id="deleteModalLabel{{ note.id }}"
                                                >
                                                    Confirmation
                                                </h5>

                                                <button
                                                    type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal"
                                                ></button>
                                            </div>

                                            <div class="modal-body">
                                                Êtes-vous sûr de vouloir supprimer la note ?
                                            </div>

                                            <div class="modal-footer">
                                                <button
                                                    type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal"
                                                >
                                                    Annuler
                                                </button>
                                                <form
                                                    method="post"
                                                    ,
                                                    action="{{ path('note_delete', {id: note.id}) }}"
                                                >
                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('delete' ~ note.id) }}"
                                                    >

                                                    <button
                                                        type="submit"
                                                        class="btn btn-danger"
                                                    >
                                                        Supprimer
                                                    </button>
                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            {% else %}
                                <tr
                                    id="matiere-{{ matiere.id }}"
                                    class="notes-detail"
                                    style="display:none;"
                                >
                                    <td colspan="6">Aucune note</td>
                                </tr>
                            {% endfor %}

                        {% endfor %}
                    </tbody>
                </table>    
            {% else %}
                <table class="table evaluations-table">
                    <tbody>
                        {% for nomMatiere, data in evaluationsParMatiere %}
                            {# Ligne matière #}
                            <tr
                                class="table-secondary matiere-row"
                                data-target="evaluations-matiere-{{ loop.index }}"
                                style="cursor:pointer;"
                            >
                                <td colspan="5">
                                    <i class="fas fa-chevron-right me-2"></i>
                                    <strong>{{ nomMatiere }}</strong>

                                    <span class="float-end">
                                        {{ data.evaluations|length }}
                                        évaluation(s)
                                        ,
                                        score moyen :
                                        {{ data.scoreMoyen|number_format(2, ',', ' ') }}
                                    </span>
                                </td>
                            </tr>

                            {% for evaluation in data.evaluations %}
                                <tr
                                    class="notes-detail evaluations-matiere-{{ loop.parent.loop.index }}"
                                    style="display:none;"
                                >
                                    <td>{{ evaluation.date|date('d/m/Y') }}</td>
                                    <td>{{ evaluation.libelle }}</td>
                                    <td style="text-align:center;">{{ evaluation.niveau }}</td>
                                    <td>
                                        {% if evaluation.isRemuneration() %}
                                            {% if evaluation.remuneration is not empty %}
                                                {{ evaluation.remuneration.montant }}
                                            {% else %}
                                                À venir
                                            {% endif %}
                                        {% else %}
                                            Aucune rémunération prévue
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a
                                            href="{{ path('evaluation_show', {id: evaluation.id}) }}"
                                            type="button"
                                            class="btn btn-success btn-sm"
                                        >Voir</a>
                                        <a
                                            {# href="{{ path('evaluation_edit', {id: evaluation.id}) }}" #}
                                            type="button"
                                            class="btn btn-warning btn-sm"
                                        >Modifier</a>
                                        <button
                                            type="button"
                                            class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal{{ evaluation.id }}"
                                        >
                                            Supprimer
                                        </button>
                                        <a
                                            href="{{ path('new_remuneration_evaluation_by_enfant', {enfantId: enfant.id, evaluationId: evaluation.id}) }}"
                                            type="button"
                                            class="btn btn-info btn-sm"
                                        >Rémunérer</a>
                                    </td>
                                </tr>

                                {# Modal suppression #}
                                <div
                                    class="modal fade"
                                    id="deleteModal{{ evaluation.id }}"
                                    tabindex="-1"
                                    aria-labelledby="deleteModalLabel{{ evaluation.id }}"
                                    aria-hidden="true"
                                >
                                    <div class="modal-dialog">
                                        <div class="modal-content">

                                            <div class="modal-header">
                                                <h5
                                                    class="modal-title"
                                                    id="deleteModalLabel{{ evaluation.id }}"
                                                >
                                                    Confirmation
                                                </h5>

                                                <button
                                                    type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal"
                                                ></button>
                                            </div>

                                            <div class="modal-body">
                                                Êtes-vous sûr de vouloir supprimer l'évaluation ?
                                            </div>

                                            <div class="modal-footer">
                                                <button
                                                    type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal"
                                                >
                                                    Annuler
                                                </button>

                                                }}"
                                                >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('delete' ~ evaluation.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="btn btn-danger"
                                                >
                                                    Supprimer
                                                </button>
                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            {% else %}
                                <tr
                                    class="notes-detail evaluations-matiere-{{ loop.index }}"
                                    style="display:none;"
                                >
                                    <td colspan="4">
                                        Aucune évaluation
                                    </td>
                                </tr>
                            {% endfor %}

                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>

        <div class="section">
            <div class="d-flex align-items-center gap-2 mb-4">
                <h2>Rémunérations</h2>
                <a href="{{ path('remuneration_new', {enfantId: enfant.id}) }}" class="btn btn-success">Ajouter une rémunération</a> 
            </div>

            <div class="remunerations-section" style="display:flex;">
                <div class="remuneration-detail col-5" style="margin-right:13em">

                    <table class="table table-striped">
                        <tbody>

                            {% for type, data in remunerationsParType %}

                                <tr
                                    class="table-secondary remuneration-row"
                                    data-target="remunerations-type-{{ loop.index }}"
                                    style="cursor:pointer;"
                                >
                                    <td colspan="5">
                                        <i class="fas fa-chevron-right me-2"></i>

                                        <strong>{{ type }}</strong>

                                        <span class="float-end">
                                            {{ data.remunerations|length }}
                                            rémunération(s)
                                            -
                                            Total :
                                            {{ data.montantTotal|number_format(2, ',', ' ') }}
                                            €
                                        </span>
                                    </td>
                                </tr>

                                {% for remuneration in data.remunerations %}

                                    <tr
                                        class="notes-detail remunerations-type-{{ loop.parent.loop.index }}"
                                        style="display:none;"
                                    >
                                        <td>
                                            {{ remuneration.date|date('d/m/Y') }}
                                        </td>

                                        <td>
                                            {% if remuneration.note %}
                                                Note
                                            {% elseif remuneration.evaluation %}
                                                Évaluation
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>

                                        <td>
                                            {% if remuneration.note %}
                                                {{ remuneration.note.matiere.name }}
                                            {% elseif remuneration.evaluation %}
                                                {{ remuneration.evaluation.matiere.name }}
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>

                                        <td>
                                            {{ remuneration.montant }}
                                            €
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr
                                        class="notes-detail remunerations-type-{{ loop.index }}"
                                        style="display:none;"
                                    >
                                        <td colspan="5">
                                            Aucune rémunération
                                        </td>
                                    </tr>

                                {% endfor %}

                            {% endfor %}

                        </tbody>
                    </table>
                </div>
            
                <div class="remuneration-graph col-6" style="width:20%">
                    <canvas id="remunerationChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{ asset('js/multibar.js') }}" type="text/javascript" charset="utf-8"></script>
    <script>
        $(".matiere-row").on("click", function () {
            const target = $(this).data("target");
            $("." + target).toggle();
        });

        var bar = $("#boxMultibarNote").multibar({
            initValue: [{{ moyenne }}],
            posMarker: "outside",
            iconMarker:"arrow-down",
            min: 0,
            max: 20,
            multiBarValue: [
                {
                    visibility: "visible",
                    val: 7,
                    bgColor: "red",
                },
                {
                    visibility: "visible",
                    val: 10,
                    bgColor: "orange",
                },
                {
                    visibility: "visible",
                    val: 13,
                    bgColor: "yellow",
                },
                {
                    visibility: "visible",
                    val: 16,
                    bgColor: "green",
                },
                {
                    visibility: "visible",
                    val: 20,
                    bgColor: "blue",
                },
            ],
            type: "normal",
            thermometer: false,
            reverse: false,
            multiBarValueVisibility: "visible",
            shadow: false,
        });

        var bar = $("#boxMultibarCompetence").multibar({
            initValue: [{{ moyenne }}],
            posMarker: "outside",
            iconMarker:"arrow-down",
            min: 0,
            max: 4,
            multiBarValue: [
                {
                    visibility: "visible",
                    val: 1,
                    bgColor: "red",
                },
                {
                    visibility: "visible",
                    val: 2,
                    bgColor: "orange",
                },
                {
                    visibility: "visible",
                    val: 3,
                    bgColor: "green",
                },
                {
                    visibility: "visible",
                    val: 4,
                    bgColor: "blue",
                }
            ],
            type: "normal",
            thermometer: false,
            reverse: false,
            multiBarValueVisibility: "visible",
            shadow: false,
        });

        const labels = {{ remunerationChartLabels|json_encode|raw }};
        const data = {{ remunerationChartData|json_encode|raw }};

        const colors = [
            '#00BCD4',
            '#FFC107',
            '#9C27B0',
            '#4CAF50',
            '#F44336',
            '#2196F3',
            '#FF9800',
            '#795548',
            '#673AB7',
            '#009688',
            '#3F51B5',
            '#E91E63',
            '#8BC34A',
            '#607D8B'
        ];

        new Chart(
            document.getElementById('remunerationChart'),
            {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: colors.slice(0, labels.length)
                    }]
                },
                options: {
                    responsive: true,

                    plugins: {
                        legend: {
                            position: 'bottom',
                            align: 'start',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        },

                        tooltip: {
                            callbacks: {
                                label: function(context) {

                                    const total = context.dataset.data.reduce(
                                        (a, b) => a + b,
                                        0
                                    );

                                    const value = context.raw;

                                    const percentage = (
                                        value / total * 100
                                    ).toFixed(1);

                                    return context.label
                                        + ' : '
                                        + value
                                        + ' € ('
                                        + percentage
                                        + '%)';
                                }
                            }
                        }
                    }
                }
            }
        );

        document.querySelectorAll('.remuneration-row').forEach(row => {
            row.addEventListener('click', function () {
                const target = this.dataset.target;

                document.querySelectorAll('.' + target).forEach(element => {
                    element.style.display =
                        element.style.display === 'none'
                            ? 'table-row'
                            : 'none';
                });

                const icon = this.querySelector('i');

                icon.classList.toggle('fa-chevron-right');
                icon.classList.toggle('fa-chevron-down');
            });
        });
    </script>
{% endblock %}
