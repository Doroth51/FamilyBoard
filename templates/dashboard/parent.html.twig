{% extends 'base.html.twig' %}

{% block title %}Dashboard Parent{% endblock %}

{% block body %}
    <div class="container py-4">

        <h1 class="mb-4">Tableau de bord familial</h1>

        <!-- Résumé global -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-md-4">
                <a href="{{ path('enfant_index') }}" class="text-decoration-none">
                    <div class="card shadow-sm p-3 text-center">
                        <h5>Enfants</h5>
                        <p class="display-6">{{ enfants|length }}</p>
                    </div>
                </a>
            </div>

            <div class="col-12 col-md-4">
                <div class="card shadow-sm p-3 text-center">
                    <h5>Périodes</h5>
                    <p class="display-6">{{ periodes|length }}</p>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card shadow-sm p-3 text-center">
                    <h5>Invitations</h5>
                    <p class="display-6">{{ invitations|length }}</p>
                </div>
            </div>

        </div>

        <!-- Liste des enfants -->
        <h3 class="mt-4">Vos enfants</h3>
        <div class="row g-3">

            {% for enfant in enfants %}
                <div class="col-12 col-md-6 col-lg-4">
                    <a href="{{ path('dashboard_enfant', { id: enfant.id }) }}" class="text-decoration-none">
                        <div class="card shadow-sm p-3">
                            <h5>{{ enfant.name }}</h5>
                            <p class="text-muted">{{ enfant.classe }}</p>
                        </div>
                    </a>
                </div>
            {% endfor %}

        </div>

        <!-- Actions -->
        <div class="mt-5 d-flex gap-3">
            <a href="{{ path('invite_parent', { id: group.id }) }}" class="btn btn-primary">
                Inviter un parent
            </a>

            <a href="{{ path('invitations_list', { id: group.id }) }}" class="btn btn-secondary">
                Invitations envoyées
            </a>
        </div>

    </div>
{% endblock %}
